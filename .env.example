# SolCrysSite — local + production env config.
#
# Copy to `.env.local` for local dev. For production, set these in the
# GitHub Actions build environment (see .github/workflows/deploy.yml).
# All Vite vars MUST be prefixed with VITE_ to be available client-side.

# ─── Lead intake routing ─────────────────────────────────────────────
# When set, marketing-site forms (Free Audit, Founder Chat, Plan Trial
# Request) POST to this endpoint instead of Formspree. Production:
#   VITE_LEAD_INTAKE_URL=https://app.solcrys.com/api/lead-intake
# Local dev: point at a local geo-platform instance:
#   VITE_LEAD_INTAKE_URL=http://localhost:3000/api/lead-intake
# Unset / blank = legacy Formspree-only behavior (safe fallback).
VITE_LEAD_INTAKE_URL=

# Dual-write window (Stage 1 migration). When "1", the form POSTs to
# lead-intake as primary AND fire-and-forgets to Formspree for audit.
# Run for ~1 week, compare inbound counts in both inboxes, then flip
# this to "0" or remove it to cut over fully.
VITE_LEAD_INTAKE_DUAL_WRITE=

# ─── App-side pricing URL (Phase E) ──────────────────────────────────
# Destination for the marketing-side Pricing nav links + the static
# /pricing/ bridge page + the SPA redirect component. Unset / blank
# = production fallback to https://app.solcrys.com/pricing. For local
# end-to-end testing of the Phase E cross-domain theme handoff, point
# at a local app dev server:
#   VITE_APP_PRICING_URL=http://localhost:3000/pricing
# The host is baked into the click interceptor at build time so the
# pre-hydration capture-phase handler also matches the local host.
VITE_APP_PRICING_URL=
